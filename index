<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Tarot - Estude, Compreenda, Integre</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        cinzel: ['Cinzel', 'serif'],
                        inter: ['Inter', 'sans-serif'],
                    },
                    colors: {
                        app: {
                            bg: '#110b29',
                            surface: '#1c143c',
                            card: '#251b4d',
                            primary: '#a87ff3',
                            secondary: '#6c539e',
                            textMain: '#ffffff',
                            textMuted: '#a398c2'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            background-color: #110b29;
            background-image: 
                radial-gradient(circle at 15% 50%, rgba(67, 40, 116, 0.4) 0%, transparent 50%),
                radial-gradient(circle at 85% 30%, rgba(45, 23, 89, 0.4) 0%, transparent 50%);
            color: white;
            font-family: 'Inter', sans-serif;
            margin: 0;
            padding: 0;
            overflow-x: hidden;
            -webkit-tap-highlight-color: transparent;
        }

        /* Custom Scrollbar */
        ::-webkit-scrollbar {
            width: 6px;
        }
        ::-webkit-scrollbar-track {
            background: #110b29; 
        }
        ::-webkit-scrollbar-thumb {
            background: #3b2d75; 
            border-radius: 10px;
        }
        ::-webkit-scrollbar-thumb:hover {
            background: #a87ff3; 
        }

        .glass-effect {
            background: rgba(28, 20, 60, 0.7);
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            border-top: 1px solid rgba(255, 255, 255, 0.05);
        }

        .card-image-placeholder {
            position: relative;
            overflow: hidden;
            border-radius: 1rem;
        }

        .card-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 1rem;
        }
        
        .pill-active {
            background: linear-gradient(90deg, #a87ff3, #d0a4ff);
            color: #110b29;
            font-weight: 600;
        }
        
        .moon-phases {
            display: flex;
            justify-content: center;
            align-items: center;
            gap: 12px;
            color: #f7e0a3;
            font-size: 1.2rem;
            margin-bottom: 10px;
        }
        
        .moon-phases i:nth-child(3) {
            font-size: 1.8rem;
            text-shadow: 0 0 15px rgba(247, 224, 163, 0.6);
        }

        .card-hover:active {
            transform: scale(0.95);
        }
        @media (hover: hover) {
            .card-hover:hover {
                transform: translateY(-5px);
                box-shadow: 0 10px 25px rgba(168, 127, 243, 0.2);
            }
        }
    </style>
</head>
<body class="min-h-screen flex flex-col pb-24">

    <!-- Header -->
    <header class="pt-12 pb-6 px-6 relative z-10">
        <div class="flex justify-between items-center mb-6">
            <button class="w-12 h-12 rounded-full bg-app-surface border border-app-secondary/30 flex justify-center items-center text-app-textMuted hover:text-white transition">
                <i class="fas fa-bars"></i>
            </button>
            
            <div class="text-center">
                <div class="moon-phases">
                    <i class="fas fa-moon" style="transform: scaleX(-1);"></i>
                    <i class="fas fa-circle-half-stroke" style="transform: scaleX(-1);"></i>
                    <i class="fas fa-circle"></i>
                    <i class="fas fa-circle-half-stroke"></i>
                    <i class="fas fa-moon"></i>
                </div>
                <h1 class="font-cinzel tracking-[0.3em] text-3xl font-bold mt-2 text-white">TAROT</h1>
                <p class="text-[0.65rem] tracking-[0.2em] text-app-textMuted mt-1 uppercase">Estude • Compreenda • Integre</p>
            </div>
            
            <button class="w-12 h-12 rounded-full bg-app-surface border border-app-secondary/30 flex justify-center items-center text-app-primary hover:text-white transition">
                <i class="fas fa-sparkles"></i>
            </button>
        </div>

        <!-- Search Bar -->
        <div class="relative w-full mb-6 group">
            <i class="fas fa-search absolute left-5 top-1/2 transform -translate-y-1/2 text-app-textMuted group-focus-within:text-app-primary transition"></i>
            <input type="text" id="searchInput" placeholder="Pesquisar arcano..." 
                class="w-full bg-app-surface border border-app-secondary/30 rounded-full py-4 pl-12 pr-12 text-sm text-white placeholder-app-textMuted focus:outline-none focus:border-app-primary focus:ring-1 focus:ring-app-primary transition shadow-lg">
            <button class="absolute right-5 top-1/2 transform -translate-y-1/2 text-app-primary">
                <i class="fas fa-sliders-h"></i>
            </button>
        </div>

        <!-- Filter Pills -->
        <div class="flex gap-3 overflow-x-auto pb-2 scrollbar-hide snap-x">
            <button onclick="filterCards('todos')" id="btn-todos" class="filter-btn pill-active whitespace-nowrap px-6 py-2.5 rounded-full text-sm snap-start flex items-center gap-2 shadow-lg shadow-app-primary/20 transition">
                <i class="fas fa-sparkles text-xs"></i> Todos
            </button>
            <button onclick="filterCards('maior')" id="btn-maior" class="filter-btn bg-app-surface border border-app-secondary/30 text-app-textMuted whitespace-nowrap px-6 py-2.5 rounded-full text-sm snap-start hover:bg-app-card transition">
                Arcanos Maiores
            </button>
            <button onclick="filterCards('menor')" id="btn-menor" class="filter-btn bg-app-surface border border-app-secondary/30 text-app-textMuted whitespace-nowrap px-6 py-2.5 rounded-full text-sm snap-start hover:bg-app-card transition">
                Arcanos Menores
            </button>
        </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 px-6 relative z-10">
        <div class="flex justify-between items-center mb-4 text-xs text-app-textMuted">
            <span id="cardCount">...</span>
            <button class="flex items-center gap-1 hover:text-white transition">
                Ordenar: Nome <i class="fas fa-chevron-down text-[10px]"></i>
            </button>
        </div>

        <!-- Cards Grid -->
        <div id="cardsGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            <!-- Cards injected via JS -->
        </div>
    </main>

    <!-- Bottom Nav -->
    <nav class="fixed bottom-0 left-0 w-full glass-effect z-40 pb-safe pt-3 px-6 rounded-t-3xl shadow-[0_-10px_40px_rgba(0,0,0,0.3)]">
        <div class="flex justify-between items-center max-w-md mx-auto mb-3">
            <a href="#" class="flex flex-col items-center gap-1 text-app-primary">
                <i class="fas fa-sparkles text-xl drop-shadow-[0_0_8px_rgba(168,127,243,0.6)]"></i>
                <span class="text-[10px] font-medium">Explorar</span>
            </a>
            <a href="#" class="flex flex-col items-center gap-1 text-app-textMuted hover:text-white transition">
                <i class="far fa-heart text-xl"></i>
                <span class="text-[10px] font-medium">Favoritos</span>
            </a>
            <a href="#" class="flex flex-col items-center gap-1 text-app-textMuted hover:text-white transition">
                <i class="fas fa-book text-xl"></i>
                <span class="text-[10px] font-medium">Diário</span>
            </a>
            <a href="#" class="flex flex-col items-center gap-1 text-app-textMuted hover:text-white transition">
                <i class="fas fa-info-circle text-xl"></i>
                <span class="text-[10px] font-medium">Sobre</span>
            </a>
            <a href="#" class="flex flex-col items-center gap-1 text-app-textMuted hover:text-white transition">
                <i class="far fa-user text-xl"></i>
                <span class="text-[10px] font-medium">Perfil</span>
            </a>
        </div>
    </nav>

    <!-- Detailed Card Modal -->
    <div id="cardModal" class="fixed inset-0 z-50 hidden">
        <div class="absolute inset-0 bg-app-bg/80 backdrop-blur-sm" onclick="closeModal()"></div>
        <div class="absolute bottom-0 left-0 w-full bg-app-surface h-[85vh] rounded-t-[2.5rem] flex flex-col shadow-[0_-10px_50px_rgba(0,0,0,0.5)] border-t border-app-secondary/20 transform transition-transform duration-300 translate-y-full" id="modalContent">
            
            <!-- Handle -->
            <div class="w-full flex justify-center pt-4 pb-2" onclick="closeModal()">
                <div class="w-16 h-1.5 bg-app-textMuted/30 rounded-full"></div>
            </div>

            <!-- Header -->
            <div class="px-8 pb-4 flex justify-between items-start border-b border-white/5">
                <div class="flex items-center gap-4">
                    <img id="modalImage" src="" alt="" class="w-16 h-24 object-cover rounded-lg border border-app-secondary/50">
                    <div>
                        <span id="modalNumber" class="font-cinzel text-app-primary text-sm font-bold tracking-widest"></span>
                        <h2 id="modalTitle" class="font-cinzel text-2xl font-bold text-white mt-1"></h2>
                    </div>
                </div>
                <button onclick="closeModal()" class="w-10 h-10 rounded-full bg-white/5 flex items-center justify-center text-app-textMuted hover:text-white transition flex-shrink-0">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Scrollable Content -->
            <div class="flex-1 overflow-y-auto px-8 py-6 space-y-8" id="modalBody">
                <!-- Content injected here -->
            </div>
        </div>
    </div>

    <!-- Application Logic and Data -->
    <script>
